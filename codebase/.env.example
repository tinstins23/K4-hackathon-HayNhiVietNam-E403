# --- OpenRouter (https://openrouter.ai/keys) ---
# KHÔNG commit key thật. Copy file này thành .env và điền key vào máy local.
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Model dùng cho ReAct Agent (trả lời học viên, tool-calling nhiều bước)
# Cần model hỗ trợ tool-calling tốt. Gợi ý free/rẻ trên OpenRouter:
#   - openai/gpt-4o-mini
#   - anthropic/claude-3.5-haiku
#   - google/gemini-2.0-flash-001
AGENT_MODEL=openai/gpt-4o-mini

# Model dùng cho Extraction Agent (trích xuất lịch từ tin nhắn, chạy nền lúc ingest)
# Có thể dùng model rẻ hơn vì task đơn giản hơn (structured output 1 lượt, không cần tool loop dài)
EXTRACTION_MODEL=openai/gpt-4o-mini

# --- App ---
DB_PATH=schedules.db
CORS_ORIGINS=*
