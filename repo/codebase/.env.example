# DISCORD BOT ENVIRONMENT VARIABLES
# 1. Mật mã Bot lấy từ Discord Developer Portal (Tab Bot -> Reset Token)
DISCORD_BOT_TOKEN=YOUR_DISCORD_BOT_TOKEN_HERE

# 2. Key kết nối LLM Model qua OpenRouter (Lấy miễn phí tại https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-v1-xxxx

# 3. Model LLM sử dụng các bản 100% MIỄN PHÍ (FREE) active trên OpenRouter:
# - google/gemini-2.0-flash-exp:free (Tốc độ cực nhanh, hỗ trợ Tool-calling tốt)
# - qwen/qwen-2.5-coder-32b-instruct:free
# - meta-llama/llama-3.1-8b-instruct:free
AGENT_MODEL=google/gemini-2.0-flash-exp:free
EXTRACTION_MODEL=google/gemini-2.0-flash-exp:free

# 4. Danh sách ID các kênh thông báo giảng viên (để trống nếu lắng nghe tất cả kênh)
ANNOUNCEMENT_CHANNEL_IDS=
