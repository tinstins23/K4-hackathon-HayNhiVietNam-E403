# DISCORD BOT ENVIRONMENT VARIABLES
# Mật mã Bot lấy từ Discord Developer Portal (Tab Bot -> Reset Token)
DISCORD_BOT_TOKEN=YOUR_DISCORD_BOT_TOKEN_HERE

# Danh sách ID các kênh thông báo (phân cách bằng dấu phẩy, để trống nếu nghe tất cả kênh)
ANNOUNCEMENT_CHANNEL_IDS=123456789012345678,876543210987654321
