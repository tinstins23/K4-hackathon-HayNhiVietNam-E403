# DISCORD BOT ENVIRONMENT VARIABLES
# 1. Mật mã Bot lấy từ Discord Developer Portal (Tab Bot -> Reset Token)
DISCORD_BOT_TOKEN=YOUR_DISCORD_BOT_TOKEN_HERE

# 2. Key kết nối LLM Model qua OpenRouter (Lấy miễn phí tại https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-v1-xxxx

# 3. Model LLM sử dụng các bản 100% MIỄN PHÍ (FREE) active trên OpenRouter:
# - google/gemini-2.0-flash-exp:free (Tốc độ cực nhanh, hỗ trợ Tool-calling tốt)
# - qwen/qwen-2.5-coder-32b-instruct:free
# - meta-llama/llama-3.1-8b-instruct:free
AGENT_MODEL=google/gemini-2.0-flash-exp:free
EXTRACTION_MODEL=google/gemini-2.0-flash-exp:free

# 4. Kênh LƯU tin nhắn vào DB (rộng — gồm cả kênh học viên chat, để AI retrieve được).
#    Để TRỐNG = lưu mọi kênh bot nhìn thấy.
WATCHED_CHANNEL_IDS=

# 5. Kênh thông báo CHÍNH THỨC (hẹp — chỉ những kênh này mới được trích xuất thành lịch).
#    Để trống = mọi kênh; việc chặn theo vai trò vẫn do db.is_official_source() lo.
ANNOUNCEMENT_CHANNEL_IDS=

# 6. Tin nhắn ngắn hơn ngưỡng này bị bỏ qua ("ok", "vâng", emoji) để search không bị loãng
MIN_CONTENT_LENGTH=10

# 7. Nơi lưu DB. Để TRỐNG là tốt nhất — mặc định neo theo vị trí file db.py, nên chạy từ
#    thư mục nào cũng trỏ đúng một file duy nhất: repo/codebase/src/schedules.db
# DB_PATH=
