# DISCORD BOT ENVIRONMENT VARIABLES
# 1. Mật mã Bot lấy từ Discord Developer Portal (Tab Bot -> Reset Token)
DISCORD_BOT_TOKEN=YOUR_DISCORD_BOT_TOKEN_HERE

# 2. Key kết nối LLM Model qua OpenRouter (Lấy tại https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-v1-xxxx

# 3. Model LLM sử dụng cho ReAct Agent và Extraction Agent (Mặc định openai/gpt-4o-mini hoặc anthropic/claude-3.5-haiku)
AGENT_MODEL=openai/gpt-4o-mini
EXTRACTION_MODEL=openai/gpt-4o-mini

# 4. Danh sách ID các kênh thông báo giảng viên (để trống nếu lắng nghe tất cả kênh)
ANNOUNCEMENT_CHANNEL_IDS=
